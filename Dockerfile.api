FROM node:22-bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-venv ffmpeg chromium fonts-liberation ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY frontend/package.json frontend/package.json
RUN corepack enable && corepack prepare pnpm@11.19.0 --activate && pnpm install --frozen-lockfile

COPY backend/requirements.txt backend/requirements.txt
RUN python3 -m venv /opt/caption-venv && /opt/caption-venv/bin/pip install --no-cache-dir -r backend/requirements.txt

COPY backend backend
COPY frontend frontend

ENV PATH="/opt/caption-venv/bin:${PATH}" \
    PYTHONUNBUFFERED=1 \
    REMOTION_BROWSER_EXECUTABLE=/usr/bin/chromium \
    CAPTION_STUDIO_UPLOADS_DIR=/data/uploads \
    CAPTION_STUDIO_OUTPUTS_DIR=/data/outputs \
    CAPTION_STUDIO_TRANSCRIPTS_DIR=/data/transcripts

EXPOSE 8000
CMD ["sh", "-c", "uvicorn app.main:app --app-dir backend --host 0.0.0.0 --port ${PORT:-8000}"]
